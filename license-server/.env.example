# SkattPro License Server - Environment Variables
# Copy this file to .env and fill in your actual API keys

# Stripe (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...       # Use sk_live_ for production

# SendGrid (from https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.xxx...n

# Stripe Webhook Secret (optional for local dev, required for production)
# Get from: Stripe Dashboard → Developers → Webhooks → Your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Database (file-based for MVP, upgrade to PostgreSQL later)
DATABASE_URL=file://./licenses.json