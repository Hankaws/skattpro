// Vercel configuration for serverless functions
{
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3.0.0",
      "maxDuration": 10
    }
  },
  "env": {
    "STRIPE_SECRET_KEY": "@stripe-secret-key",
    "SENDGRID_API_KEY": "@sendgrid-api-key",
    "DATABASE_URL": "@database-url"
  }
}