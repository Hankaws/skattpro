# Database (Supabase or Neon Postgres - use EU region)
DATABASE_URL="postgresql://user:pass@host:5432/skattpro?schema=public"
# For Supabase pooled + direct
# DIRECT_URL="postgresql://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Norwegian business defaults
DEFAULT_VAT_RATE="0.25"

# AI / LLM (Groq recommended for speed + EU — get free key at console.groq.com)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Emails (Resend.com — excellent for Norway transactional)
RESEND_API_KEY=""
RESEND_FROM="SkattPro <hello@skattpro.no>"

# Payments (Stripe Norway)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# File storage (Phase 1.5 — Vercel Blob or Supabase Storage)
# BLOB_READ_WRITE_TOKEN=...
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...

# Optional: Brreg proxy (no key needed for public enhetsregisteret)
# BRREG_API_BASE="https://data.brreg.no/enhetsregisteret/api"

# For production
# NODE_ENV=production
